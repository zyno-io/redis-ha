{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "auth",
    "replica",
    "sentinel",
    "metrics"
  ],
  "properties": {
    "migration": {
      "type": "object",
      "properties": {
        "preserveLegacySentinelIdentity": {
          "type": "boolean"
        },
        "kubectlImage": {
          "type": "string",
          "pattern": "^registry\\.k8s\\.io/kubectl:v[0-9]+\\.[0-9]+\\.[0-9]+@sha256:[a-f0-9]{64}$"
        },
        "ciliumNetworkPolicy": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^docker\\.io/library/redis:[0-9]+\\.[0-9]+\\.[0-9]+-trixie@sha256:[a-f0-9]{64}$"
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "minLength": 1
        },
        "acl": {
          "type": "object",
          "properties": {
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "username",
                  "enabled",
                  "commands",
                  "keys",
                  "channels"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "enabled": {
                    "enum": [
                      "on",
                      "off"
                    ]
                  },
                  "commands": {
                    "type": "string",
                    "pattern": "^[^\\r\\n\\t]+$"
                  },
                  "keys": {
                    "type": "string",
                    "pattern": "^[^\\r\\n\\t]+$"
                  },
                  "channels": {
                    "type": "string",
                    "pattern": "^[^\\r\\n\\t]+$"
                  }
                }
              }
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$"
            }
          }
        },
        "operator": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "replication": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "monitor": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "discovery": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]*$"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        }
      }
    },
    "replica": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "const": 3
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "updateStrategy": {
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ]
        },
        "priorityClassName": {
          "type": "string"
        },
        "minReplicasToWrite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "minReplicasMaxLag": {
          "type": "integer",
          "minimum": 1
        },
        "maxmemory": {
          "type": "string",
          "pattern": "^([1-9][0-9]*([kKmMgG][bB]?)?)?$"
        }
      }
    },
    "sentinel": {
      "type": "object",
      "properties": {
        "quorum": {
          "const": 2
        },
        "downAfterMilliseconds": {
          "type": "integer",
          "minimum": 5000
        },
        "masterSet": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^docker\\.io/oliver006/redis_exporter:v[0-9]+\\.[0-9]+\\.[0-9]+-alpine@sha256:[a-f0-9]{64}$"
        },
        "sentinel": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "podAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object"
            },
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]*$"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "username": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "existingSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]*$"
        },
        "tlsSecret": {
          "type": "string"
        }
      }
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "certKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "keyKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "caKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "serverName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.:-]*$"
        },
        "authClients": {
          "const": false
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/zyno-io/redis-ha-health:[a-zA-Z0-9_.-]+(@sha256:[a-f0-9]{64})?$"
        },
        "requireQuorum": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
